{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpintl-org.github.io/schemas/hierarchy-node.schema.json",
  "title": "CPINTL Hierarchy Node",
  "description": "One row of CPINTL_HIERARCHY_NODES.csv after conversion to a JSON object. All CSV values are strings; empty cells are empty strings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "level",
    "node_type",
    "name",
    "parent_id",
    "scope",
    "function_domain",
    "node_class",
    "lifecycle",
    "basis",
    "status"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^(GLB|HQ|BGD|THA|MMR)-(ORG|HQT|MSN|GOV|COM|DIV|DEP|UNT|SUB)-[A-Z0-9]{2,8}$",
      "description": "Immutable ID: SCOPE-TYPE-MNEMONIC."
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "node_type": {
      "enum": [
        "ORG",
        "HQT",
        "MSN",
        "GOV",
        "COM",
        "DIV",
        "DEP",
        "UNT",
        "SUB"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^&]+$",
      "description": "Canonical display name. No ampersand."
    },
    "parent_id": {
      "type": "string",
      "pattern": "^$|^(GLB|HQ|BGD|THA|MMR)-(ORG|HQT|MSN|GOV|COM|DIV|DEP|UNT|SUB)-[A-Z0-9]{2,8}$",
      "description": "Parent node ID; empty only for the root."
    },
    "scope": {
      "enum": [
        "GLB",
        "HQ",
        "BGD",
        "THA",
        "MMR"
      ]
    },
    "function_domain": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}(;[A-Z]{2,4})*$"
    },
    "node_class": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "Standing",
        "Activation-based"
      ]
    },
    "basis": {
      "enum": [
        "S",
        "U",
        "P"
      ]
    },
    "status": {
      "enum": [
        "Active",
        "Proposed",
        "Skeleton",
        "Retired"
      ]
    },
    "legacy_code": {
      "type": "string"
    },
    "aliases": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    }
  }
}
