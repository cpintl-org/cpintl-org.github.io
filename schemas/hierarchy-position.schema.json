{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpintl-org.github.io/schemas/hierarchy-position.schema.json",
  "title": "CPINTL Hierarchy Position",
  "description": "One row of CPINTL_HIERARCHY_POSITIONS.csv after conversion to a JSON object. A position is a role seat, never a person.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "position_id",
    "canonical_title",
    "home_node_id",
    "reports_to_position_id",
    "role_family",
    "function_domain",
    "smt",
    "occupancy",
    "basis"
  ],
  "properties": {
    "position_id": {
      "type": "string",
      "pattern": "^POS-(HQ|BGD|THA|MMR)-[0-9]{3}$"
    },
    "canonical_title": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^&]+$"
    },
    "home_node_id": {
      "type": "string",
      "pattern": "^(GLB|HQ|BGD|THA|MMR)-(ORG|HQT|MSN|GOV|COM|DIV|DEP|UNT|SUB)-[A-Z0-9]{2,8}$"
    },
    "reports_to_position_id": {
      "type": "string",
      "pattern": "^$|^POS-(HQ|BGD|THA|MMR)-[0-9]{3}$",
      "description": "Empty only for the top seat."
    },
    "role_family": {
      "enum": [
        "Executive",
        "Country Leadership",
        "Executive Support",
        "Director",
        "Manager",
        "Technical Specialist and Advisor",
        "Coordinator",
        "Officer, Associate and Analyst"
      ]
    },
    "function_domain": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}(;[A-Z]{2,4})*$"
    },
    "smt": {
      "enum": [
        "Y",
        "N"
      ]
    },
    "occupancy": {
      "enum": [
        "Filled",
        "Vacant"
      ]
    },
    "source_titles": {
      "type": "string"
    },
    "basis": {
      "enum": [
        "S",
        "U",
        "P"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
